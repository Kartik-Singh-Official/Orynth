# Orynth Environment Configuration Example
# Copy this file to .env and configure your local settings.
# NEVER commit .env to version control.

# Google AI Studio API Key for Gemma 4 (free from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Gemma Model Identifier (defaults to gemma-4-26b-a4b-it as required by Theme 2)
# Supported options: gemma-4-26b-a4b-it, gemma-4-31b-it, gemma-2-9b-it, gemini-2.0-flash
GEMMA_MODEL=gemma-4-26b-a4b-it

# Server configuration
PORT=8000
HOST=0.0.0.0
